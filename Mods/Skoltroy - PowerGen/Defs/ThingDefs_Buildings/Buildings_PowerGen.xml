<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- SKOLTROY PowerGen : many power generators -->

<!-- PowerGen MiniUnit -->
  <ThingDef ParentName="BuildingBase">
    <defName>Skoltroy_PowerGenMiniUnit</defName>
    <label>5.000 watts</label>
    <thingClass>Building</thingClass>
    <graphicData>
		<texPath>Things/Building/PowerGen/MiniUnit/PowerGen_1x1</texPath>
		<graphicClass>Graphic_Multi</graphicClass>
		<drawSize>(1,1)</drawSize>
      <damageData>
        <rect>(0.3,0,5.4,6)</rect>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <pathCost>70</pathCost>
	<passability>PassThroughOnly</passability>
	<castEdgeShadows>true</castEdgeShadows>
    <fillPercent>1</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
		<MaxHitPoints>1000</MaxHitPoints>
		<WorkToBuild>500</WorkToBuild>
		<Flammability>0</Flammability>
		<Beauty>0</Beauty>
		<Mass>10</Mass>
    </statBases>
    <tickerType>Normal</tickerType>
    <description>5.000 watts</description>
    <size>(1,1)</size>
	<selectable>true</selectable>
   <costList>
      <Steel>10</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-5000</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
	  <li Class="CompProperties_Glower">
        <glowRadius>1</glowRadius>
        <glowColor>(169,240,246,0)</glowColor>
      </li>
	  <li Class="CompProperties_Flickable" />
    </comps>
    <rotatable>true</rotatable>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>Power</designationCategory>
    <building>
	  <ai_chillDestination>false</ai_chillDestination>
    </building>
    <constructEffect>ConstructMetal</constructEffect>
	<minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsPower</li>
    </thingCategories>
  </ThingDef>
 
