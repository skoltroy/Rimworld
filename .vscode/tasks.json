{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "php",
      "args": [
        ".tools/build-publish.php"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PUBLISH_SANS_VERSION": "1"
        }
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "publish",
      "type": "process",
      "command": "php",
      "args": [
        ".tools/build-publish.php"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "serve",
      "detail": "Site en local sur http://localhost:8080/",
      "type": "process",
      "command": "php",
      "args": [
        "-S",
        "localhost:8080",
        "-t",
        "web"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "php",
        "pattern": {
          "regexp": "^__never__$"
        },
        "background": {
          "beginsPattern": "^.*PHP.*Development Server",
          "endsPattern": "^.*started"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
